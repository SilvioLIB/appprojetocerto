{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true,
      "cwd": "web"
    },
    {
      "name": "web-mobile",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3001,
      "cwd": "web-mobile"
    },
    {
      "name": "web-mobile-visual",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/dev-sem-login.mjs",
        "3002"
      ],
      "port": 3002,
      "cwd": "web-mobile"
    },
    {
      "name": "web-mobile-producao",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3001,
      "cwd": "web-mobile"
    },
    {
      "name": "app-estatico",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/servir-out.mjs"
      ],
      "port": 4173,
      "cwd": "web"
    }
  ]
}